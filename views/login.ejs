
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Student Management System</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body {
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
            background: linear-gradient(135deg, #0f5132, #26945c, #b5e8c5);
        }

        .login-card {
            width: 100%;
            max-width: 390px;
            padding: 40px 35px;
            background: rgba(255, 255, 255, 0.97);
            border-radius: 22px;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.18);
            text-align: center;
            animation: appear 0.6s ease;
        }

        @keyframes appear {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .logo {
            width: 80px;
            height: 80px;
            margin: 0 auto 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #e3f5e9;
            border-radius: 50%;
            font-size: 40px;
            border: 3px solid #c3e8cf;
        }

        h2 {
            color: #14532d;
            font-size: 29px;
            margin-bottom: 10px;
        }

        .subtitle {
            color: #78857c;
            font-size: 14px;
            margin-bottom: 30px;
        }

        .form-group {
            text-align: left;
            margin-bottom: 22px;
        }

        label {
            display: block;
            margin-bottom: 9px;
            color: #34483a;
            font-size: 14px;
            font-weight: bold;
        }

        .input-wrapper {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 0 14px;
            border: 1px solid #d8e5dc;
            border-radius: 10px;
            background: #f9fcfa;
            transition: 0.3s;
        }

        .input-wrapper:focus-within {
            border-color: #26945c;
            box-shadow: 0 0 0 3px rgba(38, 148, 92, 0.12);
        }

        .input-icon {
            font-size: 19px;
        }

        input {
            width: 100%;
            padding: 15px 0;
            border: none;
            outline: none;
            background: transparent;
            color: #26382d;
            font-size: 14px;
        }

        input::placeholder {
            color: #a0aaa3;
        }

        .login-button {
            width: 100%;
            padding: 15px;
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 10px;
            border: none;
            border-radius: 10px;
            background: linear-gradient(135deg, #176b43, #26945c);
            color: white;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            box-shadow: 0 6px 15px rgba(23, 107, 67, 0.2);
            transition: 0.3s;
        }

        .login-button:hover {
            transform: translateY(-2px);
            box-shadow: 0 9px 20px rgba(23, 107, 67, 0.3);
        }

        .login-button span {
            font-size: 20px;
        }

        .footer {
            margin-top: 28px;
            padding-top: 18px;
            border-top: 1px solid #edf1ed;
            color: #98a39b;
            font-size: 12px;
        }

        @media (max-width: 480px) {
            .login-card {
                padding: 35px 25px;
            }

            h2 {
                font-size: 26px;
            }
        }
    </style>
</head>

<body>

    <div class="login-card">

        <div class="logo">🎓</div>

        <h2>Welcome Back</h2>
        <p class="subtitle">Login to your student account</p>

        <form action="/login" method="POST">

            <div class="form-group">
                <label for="username">Username</label>

                <div class="input-wrapper">
                    <span class="input-icon">👤</span>

                    <input
                        type="text"
                        id="username"
                        name="username"
                        placeholder="Enter your username"
                        required
                    >
                </div>
            </div>

            <button type="submit" class="login-button">
                Login <span>→</span>
            </button>

        </form>

        <div class="footer">
            Student Management System © 2026
        </div>

    </div>

</body>
</html>
