
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Student</title>
    <link rel="stylesheet" href="/style.css">

    <style>
        body {
            margin: 0;
            padding: 30px 15px;
            background: #f3f7f4;
            font-family: Arial, sans-serif;
            color: #26382d;
        }

        .edit-card {
            max-width: 500px;
            margin: 30px auto;
            padding: 30px;
            background: white;
            border-radius: 15px;
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.08);
        }

        h1 {
            color: #176b43;
            margin-top: 0;
        }

        .subtitle {
            color: #78857c;
            margin-bottom: 25px;
        }

        label {
            display: block;
            margin: 18px 0 8px;
            font-weight: bold;
            font-size: 14px;
        }

        input {
            width: 100%;
            padding: 12px;
            border: 1px solid #d5dfd8;
            border-radius: 7px;
            box-sizing: border-box;
            font-size: 15px;
        }

        input:focus {
            outline: 2px solid #b8dfc6;
            border-color: #176b43;
        }

        .save-button {
            width: 100%;
            padding: 13px;
            margin-top: 25px;
            background: #176b43;
            color: white;
            border: none;
            border-radius: 7px;
            font-weight: bold;
            cursor: pointer;
        }

        .save-button:hover {
            background: #105331;
        }

        .cancel-link {
            display: block;
            text-align: center;
            margin-top: 18px;
            color: #176b43;
            text-decoration: none;
        }
    </style>
</head>
<body>

    <div class="edit-card">
        <h1>Edit Student</h1>
        <p class="subtitle">Update student information</p>

        <form action="/students/<%= student._id %>/edit" method="POST">

            <label for="name">Student Name</label>
            <input
                type="text"
                id="name"
                name="name"
                value="<%= student.name || '' %>"
                required
            >

            <label for="course">Course</label>
            <input
                type="text"
                id="course"
                name="course"
                value="<%= student.course || '' %>"
                required
            >

            <label for="year">Year Level</label>
            <input
                type="number"
                id="year"
                name="year"
                min="1"
                max="6"
                value="<%= student.year || '' %>"
                required
            >

            <label for="email">Email</label>
            <input
                type="email"
                id="email"
                name="email"
                value="<%= student.email || '' %>"
            >

            <button type="submit" class="save-button">
                Save Changes
            </button>
        </form>

        <a href="/students" class="cancel-link">Cancel</a>
    </div>

</body>
</html>
